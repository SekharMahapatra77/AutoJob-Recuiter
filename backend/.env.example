# ==================================================
# Backend Environment Configuration Template (.env.example)
# AI-Powered C2C Job Search & Candidate Outreach Platform
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to GitHub or version control.
# ==================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB local or Atlas connection string)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/c2c_outreach_platform

# Authentication Secret
JWT_SECRET=your_jwt_secret_here

# AI Provider Configuration (OpenAI, Groq, Ollama, or custom endpoint)
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini

# Google Gmail OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/settings/gmail/callback

# IMAP Inbound Mail Listener Configuration
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=your_email@example.com
IMAP_PASSWORD=your_app_password_here

# Optional SMTP Dispatch Fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password_here
