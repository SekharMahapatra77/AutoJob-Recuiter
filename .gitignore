# ==================================================
# Root .gitignore for AI-Powered C2C Outreach Platform
# ==================================================

# Environment variables & local secrets (protect all subdirs)
.env
.env.*
*.env
*.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local
backend/.env.local
!.env.example
!.env.sample
!backend/.env.example
!frontend/.env.example

# Node dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
backend/dist/
frontend/dist/
build/
.next/
out/
coverage/

# Runtime logs
logs/
*.log
backend/*.log
frontend/*.log

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & editor configuration
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/
*.tmp

# Uploads / generated local user files
uploads/*
!uploads/.gitkeep
!uploads/*/
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/*/
backend/uploads/resumes/*
!backend/uploads/resumes/.gitkeep
backend/uploads/csv/*
!backend/uploads/csv/.gitkeep
storage/*
!storage/.gitkeep
!storage/*/

# Local databases
*.sqlite
*.sqlite3
*.db

# Certificates, keys & credentials
*.pem
*.key
*.crt
*.p12
*.pfx
credentials.json
client_secret.json
service-account.json
service-account-key.json

# Google / Gmail OAuth local tokens
token.json
tokens.json
google-token.json
gmail-token.json

# AI / API secrets
secrets.json
secret.json

# Deployment / local config
.vercel/
.netlify/
.turbo/

# Test artifacts & generated reports
playwright-report/
test-results/
reports/generated/
